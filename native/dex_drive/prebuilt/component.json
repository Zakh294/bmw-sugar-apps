{
  "id": "dex-drive-d",
  "kind": "tool",
  "version": "0.2.4",
  "license": "MIT AND GPL-3.0-or-later AND Apache-2.0",
  "title": "DeX Drive service",
  "description": "The car side of DeX Drive: Samsung DeX (One UI 8) on the centre screen. Talks ADB to the phone over USB (usbfs, only its ADB interface) or Wi-Fi, starts scrcpy-server 5.0.1 on it with a virtual display that DeX takes, decodes the H.264 video on the unit's GPU (dexdec, Intel Media SDK) into mgu-render's video file and passes touches back; controlled by the DeX Drive app over /run/dex-drive-d/ctl.sock",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    { "path": "dex-drive-d", "from": "dex-drive-d", "mode": "0755" },
    { "path": "dexdec", "from": "dexdec", "mode": "0755" },
    { "path": "scrcpy-server", "from": "scrcpy-server", "mode": "0644" },
    { "path": "check.sh", "from": "check.sh", "mode": "0755" },
    { "path": "LICENSE", "from": "LICENSE", "mode": "0644" },
    { "path": "LICENSE.dexdec", "from": "LICENSE.dexdec", "mode": "0644" },
    { "path": "LICENSE.scrcpy", "from": "LICENSE.scrcpy", "mode": "0644" },
    { "path": "NOTICE", "from": "NOTICE", "mode": "0644" }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    { "name": "dex-drive-d.service", "from": "dex-drive-d.service" }
  ],
  "enable": [
    { "unit": "dex-drive-d.service", "target": "multi-user.target" }
  ],
  "restart": [
    "dex-drive-d.service"
  ]
}
