{
  "id": "speedcam_ua",
  "title": "SpeedCam UA",
  "description": "Офлайн-попередження про 426 стаціонарних камер автофіксації України на HUD, приладці та всередині мапи Waze / Google (Maps on cluster), за GPS машини, без телефона",
  "version": "0.4.0",
  "vendor": "custom",
  "loggingId": "OASC",
  "iconGlyph": "CAM",
  "autostart": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "cluster-render": "0.5.1"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_optional": "звук попередження і розвідка аудіосистеми",
      "_instances": "1",
      "_methods": [
        "getListMainSources",
        "getListMainSinks",
        "getListMainConnections",
        "connect",
        "disconnect"
      ]
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_optional": "звук попередження: медіаплеєр BMW для застосунків",
      "_instances": [
        "OapGenericOverlay",
        "OapGenericInterrupt",
        "OapGenericMedia"
      ],
      "playerState": "r",
      "_methods": [
        "playFile"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "SpeedCam UA",
      "buttons": [
        [
          "BTN_TEST",
          "Тест попередження"
        ],
        [
          "BTN_AUDIO",
          "Аудіо-джерела"
        ],
        [
          "BTN_SOUND",
          "Тест звуку"
        ],
        [
          "BTN_SETTINGS",
          "Налаштування"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "enabled",
      "label": "Попередження про камери",
      "type": "bool",
      "default": true
    },
    {
      "key": "showWhen",
      "label": "Коли показувати",
      "type": "choice",
      "default": "always",
      "options": [
        [
          "always",
          "Біля кожної камери"
        ],
        [
          "over",
          "Лише коли перевищую ліміт"
        ]
      ]
    },
    {
      "key": "sound",
      "label": "Звук попередження",
      "type": "choice",
      "default": "overlay",
      "options": [
        [
          "off",
          "Вимкнено"
        ],
        [
          "overlay",
          "Поверх музики (як підказка навігації)"
        ],
        [
          "interrupt",
          "Перериває музику на мить"
        ],
        [
          "media",
          "Через медіаплеєр (музика стане на паузу)"
        ]
      ]
    },
    {
      "key": "soundStyle",
      "label": "Вид сигналу",
      "type": "choice",
      "default": "ding",
      "options": [
        [
          "ding",
          "Дзень: дві ноти вгору"
        ],
        [
          "gong",
          "Гонг: дві ноти вниз, як у BMW"
        ],
        [
          "beep3",
          "Три короткі біпи"
        ],
        [
          "soft",
          "М'який: одна тиха нота"
        ],
        [
          "radar",
          "Радар: два свисти вгору"
        ]
      ]
    },
    {
      "key": "soundOver",
      "label": "Тривожний сигнал при перевищенні",
      "type": "bool",
      "default": true
    },
    {
      "key": "soundVol",
      "label": "Гучність сигналу",
      "type": "number",
      "unit": "%",
      "default": 70,
      "markDefault": true,
      "steps": [
        30,
        50,
        70,
        85,
        100
      ]
    },
    {
      "key": "showHud",
      "label": "Показувати на HUD",
      "type": "bool",
      "default": true
    },
    {
      "key": "showCluster",
      "label": "Показувати на приладці",
      "type": "bool",
      "default": true
    },
    {
      "key": "inMap",
      "label": "Всередині мапи Waze / Google, коли вона на приладці",
      "type": "bool",
      "default": true
    },
    {
      "key": "mapPlace",
      "label": "Місце в мапі",
      "type": "choice",
      "default": "center",
      "options": [
        [
          "center",
          "Вгорі по центру"
        ],
        [
          "left",
          "Вгорі ліворуч"
        ],
        [
          "right",
          "Вгорі праворуч"
        ]
      ]
    },
    {
      "key": "clusterPlace",
      "label": "Місце на приладці без мапи",
      "type": "choice",
      "default": "center",
      "options": [
        [
          "center",
          "Внизу по центру"
        ],
        [
          "left",
          "Внизу ліворуч"
        ],
        [
          "right",
          "Внизу праворуч"
        ]
      ]
    },
    {
      "key": "lead",
      "label": "Попереджати за",
      "type": "number",
      "unit": "с",
      "default": 20,
      "markDefault": true,
      "steps": [
        10,
        15,
        20,
        25,
        30,
        40
      ]
    },
    {
      "key": "minWarn",
      "label": "Не ближче ніж за",
      "type": "number",
      "unit": "м",
      "default": 300,
      "markDefault": true,
      "steps": [
        150,
        200,
        300,
        400,
        500,
        700
      ]
    },
    {
      "key": "tolerance",
      "label": "Жовта швидкість, якщо понад ліміт на",
      "type": "number",
      "unit": "км/год",
      "default": 0,
      "markDefault": true,
      "steps": [
        0,
        5,
        10,
        15
      ]
    },
    {
      "key": "size",
      "label": "Розмір попередження",
      "type": "number",
      "unit": "%",
      "default": 100,
      "markDefault": true,
      "steps": [
        60,
        70,
        80,
        90,
        100
      ]
    },
    {
      "key": "hudBright",
      "label": "Яскравість на HUD",
      "type": "number",
      "unit": "%",
      "default": 100,
      "markDefault": true,
      "steps": [
        40,
        50,
        60,
        70,
        80,
        90,
        100
      ]
    },
    {
      "key": "nightDim",
      "label": "Вночі тьмяніше (за сонцем у місці, де машина)",
      "type": "bool",
      "default": true
    }
  ],
  "config": {
    "socketPath": "/dev/shm/cluster-render/render.sock"
  }
}
