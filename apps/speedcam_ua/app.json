{
  "id": "speedcam_ua",
  "title": "SpeedCam UA",
  "description": "Офлайн-попередження про 426 стаціонарних камер автофіксації України на HUD, приладці та всередині мапи Waze / Google (Maps on cluster), за GPS машини, без телефона",
  "version": "0.3.2",
  "vendor": "custom",
  "loggingId": "OASC",
  "iconGlyph": "CAM",
  "autostart": true,
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "cluster-render": "0.5.1"
  },
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_optional": "the audio manager's lists of sources and sinks (read-only, for the chime to come)",
      "_instances": "1",
      "_methods": [
        "getListMainSources",
        "getListMainSinks"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "SpeedCam UA",
      "buttons": [
        [
          "BTN_TEST",
          "Тест попередження"
        ],
        [
          "BTN_AUDIO",
          "Аудіо-джерела"
        ],
        [
          "BTN_SETTINGS",
          "Налаштування"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "enabled",
      "label": "Попередження про камери",
      "type": "bool",
      "default": true
    },
    {
      "key": "showWhen",
      "label": "Коли показувати",
      "type": "choice",
      "default": "always",
      "options": [
        [
          "always",
          "Біля кожної камери"
        ],
        [
          "over",
          "Лише коли перевищую ліміт"
        ]
      ]
    },
    {
      "key": "showHud",
      "label": "Показувати на HUD",
      "type": "bool",
      "default": true
    },
    {
      "key": "showCluster",
      "label": "Показувати на приладці",
      "type": "bool",
      "default": true
    },
    {
      "key": "inMap",
      "label": "Всередині мапи Waze / Google, коли вона на приладці",
      "type": "bool",
      "default": true
    },
    {
      "key": "mapPlace",
      "label": "Місце в мапі",
      "type": "choice",
      "default": "center",
      "options": [
        [
          "center",
          "Вгорі по центру"
        ],
        [
          "left",
          "Вгорі ліворуч"
        ],
        [
          "right",
          "Вгорі праворуч"
        ]
      ]
    },
    {
      "key": "clusterPlace",
      "label": "Місце на приладці без мапи",
      "type": "choice",
      "default": "center",
      "options": [
        [
          "center",
          "Внизу по центру"
        ],
        [
          "left",
          "Внизу ліворуч"
        ],
        [
          "right",
          "Внизу праворуч"
        ]
      ]
    },
    {
      "key": "lead",
      "label": "Попереджати за",
      "type": "number",
      "unit": "с",
      "default": 20,
      "markDefault": true,
      "steps": [
        10,
        15,
        20,
        25,
        30,
        40
      ]
    },
    {
      "key": "minWarn",
      "label": "Не ближче ніж за",
      "type": "number",
      "unit": "м",
      "default": 300,
      "markDefault": true,
      "steps": [
        150,
        200,
        300,
        400,
        500,
        700
      ]
    },
    {
      "key": "tolerance",
      "label": "Жовта швидкість, якщо понад ліміт на",
      "type": "number",
      "unit": "км/год",
      "default": 0,
      "markDefault": true,
      "steps": [
        0,
        5,
        10,
        15
      ]
    },
    {
      "key": "size",
      "label": "Розмір попередження",
      "type": "number",
      "unit": "%",
      "default": 100,
      "markDefault": true,
      "steps": [
        60,
        70,
        80,
        90,
        100
      ]
    },
    {
      "key": "hudBright",
      "label": "Яскравість на HUD",
      "type": "number",
      "unit": "%",
      "default": 100,
      "markDefault": true,
      "steps": [
        40,
        50,
        60,
        70,
        80,
        90,
        100
      ]
    },
    {
      "key": "nightDim",
      "label": "Вночі тьмяніше (за сонцем у місці, де машина)",
      "type": "bool",
      "default": true
    }
  ],
  "config": {
    "socketPath": "/dev/shm/cluster-render/render.sock"
  }
}
