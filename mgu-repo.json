{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": ["ID7"],
    "build": {
      "python": "tools/store_build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": ["tools/store_build.py", "kit/runtime", "kit/platform", "kit/localization", "kit/icons",
        "kit/tools/build.py", "kit/tools/pack_data.py", "kit/tools/localize.py", "kit/tools/locale-revisions.json",
        "kit/tools/make_icon.js", "kit/tools/oapgen", "oap-sdk"]
    }
  },
  "components": [
    { "id": "dex-drive-d", "kind": "tool", "path": "native/dex_drive/prebuilt" }
  ]
}
